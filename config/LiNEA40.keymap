#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define NUMFUNC 3
#define CURSOR 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <CURSOR>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    input-processors = <&zip_temp_layer MOUSE 1500>;

    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転
            <&zip_xy_to_scroll_mapper>;
    };
};

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
};

&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
};

/ {
    combos {
        compatible = "zmk,combos";

        ZenkakuHankaku {
            bindings = <&kp GRAVE>;
            key-positions = <11 12>;
        };

        DeleteKey {
            bindings = <&kp DEL>;
            key-positions = <7 8>;
        };

        InsertKey {
            bindings = <&kp INS>;
            key-positions = <6 7>;
        };

        CenterClick {
            bindings = <&mkp MB3>;
            key-positions = <17 16>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <18 17>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <27 28>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <26 27>;
        };

        BootLoader {
            bindings = <&bootloader>;
            key-positions = <4 8 24>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W       &kp E        &kp R                  &kp T                                                    &kp Y              &kp U            &kp I          &kp O         &kp P
&kp A             &kp S       &kp D        &kp F                  &kp G                                                    &kp H              &kp J            &kp K          &kp L         &lt SCROLL MINUS
&mt LEFT_SHIFT Z  &kp X       &kp C        &kp V                  &kp B                                                    &kp N              &kp M            &kp COMMA      &kp DOT       &mt RIGHT_SHIFT SLASH
&kp TAB           &kp LCTRL       &kp LALT  &none                  &lt MARK SPACE     &lt NUMFUNC BACKSPACE    &lt CURSOR ENTER  &mt RGUI DEL                   &kp GRAVE      &kp PAGE_DOWN &kp PAGE_UP
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //1  トラックボール操作で自動的に有効(AML) ※LiNEA40デフォルトのまま

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans  &trans  &trans
            >;
        };

        //2  記号レイヤー  左親指 SPACE 長押しで呼出

        MARK {
            bindings = <
&kp EXCL          &kp AT            &kp HASH          &kp DOLLAR  &kp PERCENT                    &kp CARET  &kp AMPS   &kp ASTERISK  &kp LPAR       &kp RPAR
&kp LG(LS(N3))    &kp LG(LS(N4))    &kp LG(LS(N5))    &none       &none                          &kp MINUS  &kp EQUAL  &kp LBKT      &kp RBKT       &kp BSLH
&none             &none             &none             &none       &none                          &none      &none      &kp SEMI      &kp SQT        &kp GRAVE
&kp ESC           &sk LGUI          &none             &none       &trans        &mo WIRELESS     &none      &none                    &none          &none         &none
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        //3  ファンクション+テンキー  左親指 BACKSPACE 長押しで呼出

        NUMFUNC {
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4   &kp F5                     &kp N1  &kp N2  &kp N3  &kp PLUS      &kp MINUS
&kp F6   &kp F7   &kp F8  &kp F9   &kp F10                    &kp N4  &kp N5  &kp N6  &kp ASTERISK  &kp SLASH
&kp F11  &kp F12  &trans  &trans   &trans                     &kp N7  &kp N8  &kp N9  &none         &none
&none    &none    &none   &none    &none   &trans    &kp DOT  &kp N0          &none   &none         &none
            >;
        };

        //4  カーソル/ナビゲーション  右親指 ENTER 長押しで呼出

        CURSOR {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &kp LC(UP)    &kp LC(LEFT)   &kp UP    &kp LC(RIGHT)  &kp LC(DOWN)
&trans  &trans  &trans  &trans  &trans                    &kp LC(A)     &kp LEFT       &kp DOWN  &kp RIGHT      &kp LC(E)
&trans  &trans  &trans  &trans  &trans                    &kp C_PREV    &kp LG(LEFT)   &none     &kp LG(RIGHT)  &kp C_NEXT
&none   &none   &none   &none   &none   &none    &trans  &none                         &kp C_BRI_DN  &kp C_BRI_UP  &none
            >;
        };

        //5  スクロール(トラックボール)  ※LiNEA40デフォルトのまま

        SCROLL {
            bindings = <
&trans    &kp LC(LG(LEFT_ARROW))  &kp UP_ARROW  &kp LC(LG(RIGHT_ARROW))  &trans                    &kp KP_MULTIPLY  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp KP_PLUS
&trans    &kp LEFT_ARROW          &kp DOWN      &kp RIGHT_ARROW          &trans                    &kp KP_SLASH     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_MINUS
&kp HOME  &kp PAGE_DOWN           &kp END       &kp PAGE_UP              &trans                    &kp UNDER        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ENTER
&trans    &trans                  &trans        &trans                   &trans  &trans    &trans  &kp NUMBER_0                   &kp NUMBER_0  &kp DOT       &kp QUESTION
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
        };

        //6  無線/システム

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock                &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };
    };
};
